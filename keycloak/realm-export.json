{
  "realm": "inventory",
  "enabled": true,
  "displayName": "Inventory Management System",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "id": "a1b2c3d4-e5f6-4000-b001-000000000001",
        "name": "inventory-admin",
        "description": "Full administrator access to the inventory system",
        "composite": false,
        "clientRole": false,
        "containerId": "inventory"
      },
      {
        "id": "a1b2c3d4-e5f6-4000-b001-000000000002",
        "name": "warehouse-clerk",
        "description": "Manage products and stock movements",
        "composite": false,
        "clientRole": false,
        "containerId": "inventory"
      },
      {
        "id": "a1b2c3d4-e5f6-4000-b001-000000000003",
        "name": "auditor",
        "description": "View reports and audit logs",
        "composite": false,
        "clientRole": false,
        "containerId": "inventory"
      },
      {
        "id": "a1b2c3d4-e5f6-4000-b001-000000000004",
        "name": "viewer",
        "description": "Read-only access to products and stock",
        "composite": false,
        "clientRole": false,
        "containerId": "inventory"
      }
    ]
  },
  "clients": [
    {
      "id": "b1b2c3d4-e5f6-4000-b002-000000000001",
      "clientId": "inventory-backend",
      "name": "Inventory Backend API",
      "description": "Spring Boot resource server. Valida bearer tokens y declara el modelo de Authorization Services (Resources, Policies, Permissions) del sistema.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Product",
            "type": "urn:inventory:resources:product",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "product:view"
              },
              {
                "name": "product:manage"
              }
            ]
          },
          {
            "name": "Stock",
            "type": "urn:inventory:resources:stock",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "stock:view"
              },
              {
                "name": "stock:manage"
              }
            ]
          },
          {
            "name": "Report",
            "type": "urn:inventory:resources:report",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "report:view"
              }
            ]
          },
          {
            "name": "Audit",
            "type": "urn:inventory:resources:audit",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "audit:view"
              }
            ]
          },
          {
            "name": "User",
            "type": "urn:inventory:resources:user",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "user:manage"
              }
            ]
          }
        ],
        "scopes": [
          {
            "name": "product:view"
          },
          {
            "name": "product:manage"
          },
          {
            "name": "stock:view"
          },
          {
            "name": "stock:manage"
          },
          {
            "name": "report:view"
          },
          {
            "name": "audit:view"
          },
          {
            "name": "user:manage"
          }
        ],
        "policies": [
          {
            "name": "Es Administrador de inventario",
            "description": "El usuario tiene el rol de realm 'inventory-admin'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"inventory-admin\", \"required\": false}]"
            }
          },
          {
            "name": "Es Encargado de almacen",
            "description": "El usuario tiene el rol de realm 'warehouse-clerk'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"warehouse-clerk\", \"required\": false}]"
            }
          },
          {
            "name": "Es Auditor",
            "description": "El usuario tiene el rol de realm 'auditor'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"auditor\", \"required\": false}]"
            }
          },
          {
            "name": "Es Consultor",
            "description": "El usuario tiene el rol de realm 'viewer'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"viewer\", \"required\": false}]"
            }
          },
          {
            "name": "Permite product:view",
            "description": "Concede 'product:view' sobre Product a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Product\"]",
              "scopes": "[\"product:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite product:manage",
            "description": "Concede 'product:manage' sobre Product a: inventory-admin, warehouse-clerk",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Product\"]",
              "scopes": "[\"product:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\"]"
            }
          },
          {
            "name": "Permite stock:view",
            "description": "Concede 'stock:view' sobre Stock a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Stock\"]",
              "scopes": "[\"stock:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite stock:manage",
            "description": "Concede 'stock:manage' sobre Stock a: inventory-admin, warehouse-clerk",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Stock\"]",
              "scopes": "[\"stock:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\"]"
            }
          },
          {
            "name": "Permite report:view",
            "description": "Concede 'report:view' sobre Report a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Report\"]",
              "scopes": "[\"report:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite audit:view",
            "description": "Concede 'audit:view' sobre Audit a: inventory-admin, auditor",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Audit\"]",
              "scopes": "[\"audit:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Auditor\"]"
            }
          },
          {
            "name": "Permite user:manage",
            "description": "Concede 'user:manage' sobre User a: inventory-admin",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"User\"]",
              "scopes": "[\"user:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\"]"
            }
          }
        ]
      }
    },
    {
      "id": "b1b2c3d4-e5f6-4000-b002-000000000002",
      "clientId": "inventory-frontend",
      "name": "Inventory Frontend SPA",
      "description": "React SPA — public client with PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt",
        "product:view",
        "product:manage",
        "stock:view",
        "stock:manage",
        "report:view",
        "user:manage",
        "audit:view"
      ]
    },
    {
      "id": "b1b2c3d4-e5f6-4000-b002-000000000003",
      "clientId": "inventory-zap",
      "name": "OWASP ZAP scanner",
      "description": "Cliente dedicado al escaneo de seguridad (TEST-10b). Token de vida larga para que no caduque a mitad del escaneo activo, que puede durar mas de los 300 s del realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt",
        "product:view",
        "product:manage",
        "stock:view",
        "stock:manage",
        "report:view",
        "user:manage",
        "audit:view"
      ]
    }
  ]
}
