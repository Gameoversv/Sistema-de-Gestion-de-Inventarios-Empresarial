{
  "realm": "inventory",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "inventory-admin",
        "description": "Full access — IT"
      },
      {
        "name": "viewer",
        "description": "Read-only — IT"
      },
      {
        "name": "warehouse-clerk",
        "description": "Encargado de almacen"
      },
      {
        "name": "auditor",
        "description": "Auditor"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "product:view",
      "description": "View product catalog",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "product:manage",
      "description": "Create and update products",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "product:view",
      "roles": [
        "inventory-admin",
        "viewer"
      ]
    },
    {
      "clientScope": "product:manage",
      "roles": [
        "inventory-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "inventory-frontend",
      "name": "Inventory Frontend — IT",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "product:view",
        "product:manage"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "inventory-backend",
      "name": "Inventory Backend API",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "nodeReRegistrationTimeout": -1,
      "fullScopeAllowed": true,
      "description": "Spring Boot resource server. Valida bearer tokens y declara el modelo de Authorization Services (Resources, Policies, Permissions) del sistema.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Product",
            "type": "urn:inventory:resources:product",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "product:view"
              },
              {
                "name": "product:manage"
              }
            ]
          },
          {
            "name": "Stock",
            "type": "urn:inventory:resources:stock",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "stock:view"
              },
              {
                "name": "stock:manage"
              }
            ]
          },
          {
            "name": "Report",
            "type": "urn:inventory:resources:report",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "report:view"
              }
            ]
          },
          {
            "name": "Audit",
            "type": "urn:inventory:resources:audit",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "audit:view"
              }
            ]
          },
          {
            "name": "User",
            "type": "urn:inventory:resources:user",
            "ownerManagedAccess": false,
            "scopes": [
              {
                "name": "user:manage"
              }
            ]
          }
        ],
        "scopes": [
          {
            "name": "product:view"
          },
          {
            "name": "product:manage"
          },
          {
            "name": "stock:view"
          },
          {
            "name": "stock:manage"
          },
          {
            "name": "report:view"
          },
          {
            "name": "audit:view"
          },
          {
            "name": "user:manage"
          }
        ],
        "policies": [
          {
            "name": "Es Administrador de inventario",
            "description": "El usuario tiene el rol de realm 'inventory-admin'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"inventory-admin\", \"required\": false}]"
            }
          },
          {
            "name": "Es Encargado de almacen",
            "description": "El usuario tiene el rol de realm 'warehouse-clerk'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"warehouse-clerk\", \"required\": false}]"
            }
          },
          {
            "name": "Es Auditor",
            "description": "El usuario tiene el rol de realm 'auditor'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"auditor\", \"required\": false}]"
            }
          },
          {
            "name": "Es Consultor",
            "description": "El usuario tiene el rol de realm 'viewer'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"viewer\", \"required\": false}]"
            }
          },
          {
            "name": "Permite product:view",
            "description": "Concede 'product:view' sobre Product a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Product\"]",
              "scopes": "[\"product:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite product:manage",
            "description": "Concede 'product:manage' sobre Product a: inventory-admin, warehouse-clerk",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Product\"]",
              "scopes": "[\"product:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\"]"
            }
          },
          {
            "name": "Permite stock:view",
            "description": "Concede 'stock:view' sobre Stock a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Stock\"]",
              "scopes": "[\"stock:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite stock:manage",
            "description": "Concede 'stock:manage' sobre Stock a: inventory-admin, warehouse-clerk",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Stock\"]",
              "scopes": "[\"stock:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\"]"
            }
          },
          {
            "name": "Permite report:view",
            "description": "Concede 'report:view' sobre Report a: inventory-admin, warehouse-clerk, auditor, viewer",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Report\"]",
              "scopes": "[\"report:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Encargado de almacen\", \"Es Auditor\", \"Es Consultor\"]"
            }
          },
          {
            "name": "Permite audit:view",
            "description": "Concede 'audit:view' sobre Audit a: inventory-admin, auditor",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"Audit\"]",
              "scopes": "[\"audit:view\"]",
              "applyPolicies": "[\"Es Administrador de inventario\", \"Es Auditor\"]"
            }
          },
          {
            "name": "Permite user:manage",
            "description": "Concede 'user:manage' sobre User a: inventory-admin",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"User\"]",
              "scopes": "[\"user:manage\"]",
              "applyPolicies": "[\"Es Administrador de inventario\"]"
            }
          }
        ]
      }
    }
  ],
  "users": [
    {
      "username": "it-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "it-admin@inventory.local",
      "firstName": "IT",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "it-admin-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "inventory-admin"
      ]
    },
    {
      "username": "it-viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "it-viewer@inventory.local",
      "firstName": "IT",
      "lastName": "Viewer",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "it-viewer-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ]
}
